{
  "expo": {
    "name": "agriOS",
    "slug": "agriOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "agrios",
    "assetBundlePatterns": [
      "assets/**",
      "assets/model/**"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agrios.app",
      "infoPlist": {
        "NSCameraUsageDescription": "agriOS uses the camera to scan your crops for diseases.",
        "NSLocationWhenInUseUsageDescription": "agriOS records the location of crop issues to show them on your field map.",
        "NSMicrophoneUsageDescription": "agriOS uses the microphone to record voice observations in your local language."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D6A4F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.agrios.app",
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "agriOS records the location of issues to build your field map."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "agriOS uses the microphone to record voice observations in your local language."
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2D6A4F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-image",
      "react-native-fast-tflite",
      [
        "expo-sensors",
        {
          "motionPermission": "agriOS uses motion sensors to look around the demo scene."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
