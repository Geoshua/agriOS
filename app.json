{
  "expo": {
    "name": "agriOS",
    "slug": "agriOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D6A4F"
    },
    "scheme": "agriOS",
    "assetBundlePatterns": [
      "assets/**",
      "assets/audio/**",
      "assets/model/**"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agrios.app",
      "infoPlist": {
        "NSCameraUsageDescription": "agriOS uses the camera to scan your crops for diseases.",
        "NSLocationWhenInUseUsageDescription": "agriOS records the location of crop issues to show them on your field map.",
        "NSMicrophoneUsageDescription": "agriOS uses the microphone to record voice observations in your local language."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D6A4F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.agrios.app",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "agriOS records the location of issues to build your field map."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "agriOS uses the microphone to record voice observations in your local language."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
